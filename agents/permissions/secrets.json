{
  "files": [
    ".config/zsh/private/**",
    ".ssh/id_*",
    ".aws/credentials",
    ".config/gcloud/**",
    ".oci/**",
    ".config/gh/hosts.yml",
    ".git-credentials",
    ".netrc"
  ],
  "commands": [
    "env",
    "printenv *",
    "export",
    "set",
    "secret *",
    "gh auth token *",
    "security find-generic-password *",
    "security dump-keychain *",
    "gcloud auth print-access-token *",
    "gcloud auth application-default print-access-token *"
  ]
}
