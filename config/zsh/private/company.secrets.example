# Secrets for one company. Git does not track config/zsh/private/COMPANY.secrets.zsh.
# Copy this file to config/zsh/private/COMPANY.secrets.zsh with mode 600.
# Set zdot_company=COMPANY in config/zsh/zshenv.local.
# .zshenv loads it after config/zsh/private/secrets.zsh, so its values win.

# Tokens
# export GITHUB_TOKEN="..."
# export NPM_TOKEN="..."

# Company skills
# The linear, notion, and slack skills use these tokens when no MCP server is available.
# export LINEAR_API_KEY="..."
# export NOTION_TOKEN="..."
# export SLACK_BOT_TOKEN="..."
