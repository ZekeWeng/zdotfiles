# Secrets for this computer only. install-dotfiles.sh copies this file to ~/.config/zsh/private/secrets.zsh.
# The file is outside the repo, so agents that work in the repo cannot read it. Its mode is 600.
# Do not put tokens here. Put each token in the Keychain with "secret-set NAME".
# Then run a command with "with-secret NAME COMMAND", such as "with-secret GITHUB_TOKEN gh pr list".
