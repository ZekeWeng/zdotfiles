# Secrets for one company. Copy this file to ~/.config/zsh/private/COMPANY.secrets.zsh with mode 600.
# Set zdot_company=COMPANY in config/zsh/zshenv.local.
# .zshenv loads it after ~/.config/zsh/private/secrets.zsh, so its values win.

# Tokens
# Do not export tokens here. Each shell loads this file, also the shells of agents, so each agent can read them.
# Put each token in the Keychain with "secret-set NAME".
# Then run a command with "with-secret NAME COMMAND", such as "with-secret GITHUB_TOKEN gh pr list".
# For a tool that you use often, add a function to config/zsh/companies/COMPANY/aliases.zsh:
#   hf() { with-secret HF_TOKEN command hf "$@"; }
# On Linux, secret-set and with-secret use files encrypted by age.

# Company skills
# The linear, notion, and slack skills use these tokens when no MCP server is available.
# Put them in the Keychain with secret-set, the same as the tokens above:
# LINEAR_API_KEY, NOTION_TOKEN, and SLACK_BOT_TOKEN.
