# Ghostty config for this computer only. Git does not track config/ghostty/local.
# ~/.config/ghostty/local links to it. Ghostty reads it last, so its values win.

# font-size = 16

# Background design. The termbg command writes this file. Run "tbg" to see the modes.
# custom-shader = ~/.local/state/ghostty/termbg.glsl
# Move the design in all panes, not only in the focused pane. This uses more CPU for each pane.
# custom-shader-animation = always

# Terminal colors. "tbg light" and "tbg dark" write this file. Ghostty reads it after this file, so its colors win.
config-file = ?~/.local/state/ghostty/termbg.colors
