# Homebrew packages for the shell on each computer.

# Shell
brew "zsh"
brew "starship"
brew "tmux"

# Search and navigation
brew "fd"
brew "fzf"
brew "ripgrep"
brew "zoxide"

# Files
brew "bat"
brew "eza"

# Secrets
# On Linux, secret-set and with-secret use age, because Linux has no Keychain.
brew "age"
