# Homebrew packages for the tools on each computer.

# Git
brew "git"
brew "git-delta"
brew "git-lfs"
brew "gh"
brew "lazygit"

# Data and files
brew "jq"
brew "yq"
brew "sevenzip"

# System
brew "htop"

# Lint and format
brew "shellcheck"
brew "shfmt"
brew "stylua"
brew "taplo"

# Cloud
brew "awscli"

# Databases and services
brew "postgresql@15"
brew "rabbitmq"

# Editors
brew "neovim"
brew "tree-sitter-cli"
cask "cursor"

# AI
cask "claude"
cask "codex"
cask "chatgpt"
